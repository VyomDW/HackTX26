# Server (copy to server/.env)
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
MUSE_API_KEY=
MUSE_BASE_URL=
MUSE_MODEL=muse-spark-1.3-contributor
# Optional: defaults to MUSE_API_KEY; set alone to use real transcription with mocked Muse Spark
MUSE_VOICE_API_KEY=
SERPAPI_KEY=
# Verification emails (sign-up sends a 6-digit code). Pick one; with neither, codes print to the server log in dev.
# SMTP, e.g. Gmail with an app password: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or Resend (https://resend.com); EMAIL_FROM must be on a domain you verified there
RESEND_API_KEY=
EMAIL_FROM=
# Signs session tokens; set a long random value in production
SESSION_SECRET=
